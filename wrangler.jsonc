{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "power-plant-website",
  "compatibility_date": "2026-08-27",
  "main": "src/index.js",
  "secrets": {
    "required": ["ADMIN_PASSWORD"]
  },
  "kv_namespaces": [
    {
      "binding": "SHARED_BOARD",
      "id": "fcae3bdfe7424fa9bde0c071d38ae177"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
